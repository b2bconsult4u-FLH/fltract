{
  "name": "fltract-public-boundary",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "fltract.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "ASSETS",
      "service": "fltract"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
