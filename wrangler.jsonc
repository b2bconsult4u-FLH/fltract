{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fltract",
  "main": "workers/public-assets/worker.mjs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
